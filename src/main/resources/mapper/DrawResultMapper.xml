<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group.admin.mapper.DrawResultMapper">

  <resultMap id="DrawResultMap" type="com.group.admin.entity.DrawResult">
    <result column="drawId" property="drawId" />
    <result column="amount" property="amount" />
    <result column="createDate" property="createDate" />
    <result column="drawCount" property="drawCount" />
    <result column="drawTime" property="drawTime" />
    <result column="prizeNumber" property="prizeNumber" />
    <result column="productDetailId" property="productDetailId" />
    <result column="productId" property="productId" />
    <result column="remainingDrawCount" property="remainingDrawCount" />
    <result column="remainingTime" property="remainingTime" />
    <result column="status" property="status" />
    <result column="totalDrawCount" property="totalDrawCount" />
    <result column="updateDate" property="updateDate" />
    <result column="userId" property="userId" />
    <result column="imageUrls" property="imageUrls" />
    <result column="productName" property="productName" />
    <result column="bonusPrice" property="bonusPrice" />
    <result column="price" property="price" />
    <result column="sliverPrice" property="sliverPrice" />
    <result column="payType" property="payType" />
    <result column="endTimes" property="endTimes" />
    <result column="level" property="level" />
  </resultMap>

  <select id="selectByExample" resultMap="DrawResultMap" parameterType="com.group.admin.example.DrawResultExample">
    SELECT * FROM draw_result
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </select>

  <select id="countByExample" resultType="long" parameterType="com.group.admin.example.DrawResultExample">
    SELECT COUNT(*) FROM draw_result
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </select>

  <delete id="deleteByExample" parameterType="com.group.admin.example.DrawResultExample">
    DELETE FROM draw_result
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </delete>

</mapper>
