<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group.admin.mapper.LotteryMapper">

  <resultMap id="LotteryMap" type="com.group.admin.entity.Lottery">
    <result column="id" property="id" />
    <result column="storeId" property="storeId" />
    <result column="title" property="title" />
    <result column="description" property="description" />
    <result column="imageUrl" property="imageUrl" />
    <result column="category" property="category" />
    <result column="subCategory" property="subCategory" />
    <result column="pricePerDraw" property="pricePerDraw" />
    <result column="discountedPrice" property="discountedPrice" />
    <result column="autoDiscountEnabled" property="autoDiscountEnabled" />
    <result column="allowMultiDraw" property="allowMultiDraw" />
    <result column="multiDrawOptions" property="multiDrawOptions" />
    <result column="scheduledAt" property="scheduledAt" />
    <result column="startTime" property="startTime" />
    <result column="endTime" property="endTime" />
    <result column="totalDraws" property="totalDraws" />
    <result column="maxDraws" property="maxDraws" />
    <result column="status" property="status" />
    <result column="orderNum" property="orderNum" />
    <result column="weight" property="weight" />
    <result column="createdBy" property="createdBy" />
    <result column="createdAt" property="createdAt" />
    <result column="updatedAt" property="updatedAt" />
    <result column="remark" property="remark" />
  </resultMap>

  <select id="selectByExample" resultMap="LotteryMap" parameterType="com.group.admin.example.LotteryExample">
    SELECT * FROM lottery
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </select>

  <select id="countByExample" resultType="long" parameterType="com.group.admin.example.LotteryExample">
    SELECT COUNT(*) FROM lottery
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </select>

  <delete id="deleteByExample" parameterType="com.group.admin.example.LotteryExample">
    DELETE FROM lottery
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
            <foreach collection="criteria.conditions.entrySet()" item="entry" index="key">
              and ${key} = #{entry.value}
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </delete>

</mapper>
