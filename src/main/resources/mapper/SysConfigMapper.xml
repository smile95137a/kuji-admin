<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group.admin.mapper.SysConfigMapper">

  <resultMap id="SysConfigMap" type="com.group.admin.entity.SysConfig">
    <result column="variable" property="variable" />
    <result column="value" property="value" />
    <result column="setTime" property="setTime" />
    <result column="setBy" property="setBy" />
  </resultMap>

  <select id="selectByExample" resultMap="SysConfigMap" parameterType="com.group.admin.entity.example.SysConfigExample">
    SELECT * FROM sys_config
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <foreach collection="criteria.conditions.entrySet()" item="entry">
          ${entry.key} = #{entry.value} AND
        </foreach>
      </foreach>
    </where>
  </select>
</mapper>
