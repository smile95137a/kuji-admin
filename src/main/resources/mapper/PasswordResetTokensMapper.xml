  <select id="selectByExample" resultMap="PasswordResetTokensMap" parameterType="com.group.admin.example.PasswordResetTokensExample">
    SELECT * FROM password_reset_tokens
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
