<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.group.admin.mapper.LotteryTagMapper">
  <resultMap id="BaseResultMap" type="com.group.admin.entity.LotteryTag">
    <id column="id" jdbcType="VARCHAR" property="id" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <result column="status" jdbcType="VARCHAR" property="status" />
    <result column="display_order" jdbcType="INTEGER" property="displayOrder" />
    <result column="created_at" jdbcType="TIMESTAMP" property="createdAt" />
    <result column="updated_at" jdbcType="TIMESTAMP" property="updatedAt" />
  </resultMap>

  <sql id="Base_Column_List">
    id, name, status, display_order, created_at, updated_at
  </sql>

  <select id="selectById" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM lottery_tag
    WHERE id = #{id}
  </select>

  <select id="selectByName" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM lottery_tag
    WHERE name = #{name}
    LIMIT 1
  </select>

  <select id="selectByNameIgnoreCase" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM lottery_tag
    WHERE LOWER(name) = LOWER(#{name})
    LIMIT 1
  </select>

  <select id="selectByNormalizedName" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM lottery_tag
    WHERE LOWER(REPLACE(REPLACE(TRIM(name), '　', ' '), '  ', ' ')) = #{normalizedName}
    LIMIT 1
  </select>

  <select id="selectAll" resultMap="BaseResultMap">
    SELECT
    <include refid="Base_Column_List" />
    FROM lottery_tag
    <where>
      <if test="status != null and status != ''">
        status = #{status}
      </if>
    </where>
    ORDER BY display_order ASC, created_at DESC
  </select>

  <insert id="insert" parameterType="com.group.admin.entity.LotteryTag">
    INSERT INTO lottery_tag (
      id, name, status, display_order, created_at, updated_at
    ) VALUES (
      #{id}, #{name}, #{status}, #{displayOrder}, #{createdAt}, #{updatedAt}
    )
  </insert>

  <update id="updateByPrimaryKeySelective" parameterType="com.group.admin.entity.LotteryTag">
    UPDATE lottery_tag
    <set>
      <if test="name != null">name = #{name},</if>
      <if test="status != null">status = #{status},</if>
      <if test="displayOrder != null">display_order = #{displayOrder},</if>
      updated_at = NOW()
    </set>
    WHERE id = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM lottery_tag
    WHERE id = #{id}
  </delete>
</mapper>
