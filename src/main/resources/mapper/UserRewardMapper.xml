  <select id="selectByExample" resultMap="UserRewardMap" parameterType="com.group.admin.example.UserRewardExample">
    SELECT * FROM user_reward
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.conditions.size() > 0">
          <trim prefix="(" suffix=")" prefixOverrides="and">
